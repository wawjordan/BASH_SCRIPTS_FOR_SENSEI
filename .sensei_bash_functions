function clean_SENSEI() {
  local patterns=(
    "nohup.out"
    "*.dat"
    "*.txt"
    "*.rst"
    "*.tar"
    "sensei.nml.*"
    "sensei_turb.nml.*"
    "*.deexact*"
    "fort.0"
    "*-coarse.bc"
    "*-agglom.bc"
    "*-coarse.grd"
    "*-fine.grd"
    "*.hdf5.out"
    )
  local verbose=${1:-"v"}
  local file_pat=${1:-"*/"}
  local v=0
  local pattern=""
  local DIR=$( pwd )/
  local file="file"
  local yn="n"
  case "$verbose" in
    v|V )
      v=1
      ;;
    * )
      v=0
      ;;
  esac
  read -p "Continue (y/n)?" yn
  case "$yn" in 
    y|Y )
      for pattern in "${patterns[@]}" ; do
        for file in ${DIR}${pattern} ; do
          if [ -f "${file}" ]; then
            if [ ${v} -eq 1 ]; then
              echo "removing ${file}"
            fi
          rm -f "${file}"
          fi
        done
      done
    ;;
    n|N ) echo "cancelling operation";;
    * ) echo "invalid response";;
  esac
}

