function get_meta_data_path() {
  local path_to_executable=$1
  local build_dir=$(dirname "$(dirname "$(realpath "$path_to_executable")")")
  local filename="metadata.log"
  local metadata=$(realpath -m "$build_dir/$filename")
  if [ -f "$metadata" ]; then
    echo "$metadata"
    return 0
  else
    echo "$metadata not found in $build_dir"
    return 1
  fi
}

function has_sensei_nml() {
  if [ -f "sensei.nml" ]; then
    return 0
  else
    echo "error: no sensei.nml in current directory"
    return 1
  fi
}

function ____pre_sensei() {
  has_sensei_nml || return $?
  local exec=$1
  local metadata=$(get_meta_data_path "${exec}")
  if [ !$? ]; then
    echo "cp ${metadata} ."
    cp "${metadata}" .
  fi
  return 0
}

function ____print_pid_info() {
  local PID=$1
  local NAME="name"
  if ps -p $PID > /dev/null; then
    printf "%s" $PID > pid.txt
    printf "%s" " " >> pid.txt
    NAME=$(ps -p $PID -o comm=)
    printf "%s" $NAME >> pid.txt
    printf "%s" " " >> pid.txt
    printf "%(%s)T" -1 >> pid.txt
  fi
}

function SENSEI_HO_dev-debug() {
  local exec=$DEFAULT_HO_DEV_DEBUG/bin/SENSEI
  ____pre_sensei $exec || return $?
  ${exec} 2>&1 | tee log_$(date +"%Y-%m-%d_%H:%M%S").txt
}

function SENSEI_HO_dev-release() {
  local exec=$DEFAULT_HO_DEV_RELEASE/bin/SENSEI
  ____pre_sensei $exec || return $?
