function stop_SENSEI_cases() {
  local DIR=$( pwd )/
  local file="pid.txt"
  local PID=0
  local NAME="name1"
  local NAME2="name2"
  local RUN_TIME=0
  local START_TIME=0
  local CURR_TIME=0
  local DIFF=0
  local d=""
  local yn="n"
  while true; do
    read -p "Stop all cases located in ${DIR}? (y/n): " yn
    case $yn in
        [Yy]* ) 
            for d in ${DIR}*/ ; do
              cd $d
              if [ -f "$file" ]; then
                echo "$file found"
                echo "($d$file)"
                read -r PID NAME START_TIME < "$file"
                echo "process ID: $PID"
                echo "command name: $NAME"
                echo "start time: $START_TIME"
                if ps -p $PID > /dev/null; then
                  echo "process $PID is running"
                  NAME2=$(ps -p $PID -o comm=)
                  if [ "$NAME2"="$NAME" ]; then
                    echo "process name $NAME2 matches saved process name $NAME"
                    CURR_TIME=$(printf "%(%s)T\n" -1)
                    DIFF=$((CURR_TIME-START_TIME))
                    echo "calculated run time is $DIFF"
                    RUN_TIME=$(ps -p $PID -o etimes=)
                    RUN_TIME=$((RUN_TIME+1))
                    echo "run time is $RUN_TIME"
                    if [ "$DIFF" -le "$RUN_TIME" ]; then
                      echo "run time matches - killing process"
                      kill $PID
                    else
                      echo "run time does not match - skipping"
                    fi
                  else
                    echo "process name $NAME2 does not match saved process name $NAME"
                  fi
                else
                  echo "process $PID is not running"
                fi
              else
                echo "$file not found"
                echo "($d$file)"
              fi
              cd ${DIR}
            done
            break
            ;;
        [Nn]* ) 
            echo "Operation canceled."
            exit 0
            ;;
        * ) 
            echo "Please answer yes or no."
            ;;
    esac
done
}

function copy_SENSEI_results () {
  local PAT=$1
  local DEST=${2:-"${DEFAULT_OUTPUT_FOLDER}"}
  local DIR=$( pwd )/
  local DATE_STR=$(date +"%Y-%m-%d_%H.%M.%S")
  local FOLDER=""
  local d=""
  FOLDER="${DIR%"${DIR##*[!/]}"}" # extglob-free multi-trailing-/ trim
  FOLDER="${FOLDER##*/}"          # remove everything before the last /
  FOLDER=${FOLDER:-/}             # correct for DIR=/ case
  mkdir -p ${DEST}${FOLDER}
  for d in ${DIR}${PAT}*/ ; do
    cp -r $d ${DEST}${FOLDER}
  done
}
